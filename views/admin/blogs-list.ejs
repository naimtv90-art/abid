<%- include('./layout-header', { title, currentSection }) %>

<!-- Header and Controls -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
  <div>
    <h1 style="font-size: 1.75rem; font-weight: 800; color: #06182f; letter-spacing: -0.02em; margin-bottom: 4px;">
      Audiology Journal &amp; Blog Posts
    </h1>
    <p style="color: #64748b; font-size: 0.92rem;">
      Manage clinical guides, patient education articles, and audiological news.
    </p>
  </div>
  <a href="/admin/blogs/new" class="btn-primary">
    <span>✍️</span> Write New Blog Post
  </a>
</div>

<!-- Filters & Search Toolbar -->
<div class="admin-card" style="padding: 16px 20px; margin-bottom: 24px;">
  <form method="GET" action="/admin/blogs" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
    
    <!-- Search Input -->
    <div style="flex: 1; min-width: 240px; position: relative;">
      <input 
        type="text" 
        id="blogSearchInput"
        name="search" 
        value="<%= querySearch %>" 
        placeholder="Search articles by title, topic, or keywords..." 
        style="width: 100%; height: 42px; padding: 0 14px 0 38px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-family: inherit; font-size: 0.88rem; outline: none;"
      >
      <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.95rem;">🔍</span>
    </div>

    <!-- Category Filter -->
    <div style="min-width: 180px;">
      <select 
        name="category" 
        onchange="this.form.submit()" 
        style="width: 100%; height: 42px; padding: 0 14px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-family: inherit; font-size: 0.88rem; outline: none; background: #ffffff;"
      >
        <option value="all" <%= queryCategory === 'all' ? 'selected' : '' %>>All Categories (<%= allCategories.length %>)</option>
        <% allCategories.forEach(c => { %>
          <option value="<%= c %>" <%= queryCategory.toLowerCase() === c.toLowerCase() ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>

    <button type="submit" class="btn-secondary" style="height: 42px; padding: 0 16px;">
      Filter
    </button>

    <% if (querySearch || queryCategory !== 'all') { %>
      <a href="/admin/blogs" class="btn-secondary" style="height: 42px; display: inline-flex; align-items: center; color: #ef4444; border-color: #fecaca; background: #fef2f2;">
        Reset
      </a>
    <% } %>

  </form>
</div>

<!-- Blog Articles Table Card -->
<div class="admin-card" style="padding: 0; overflow: hidden;">
  <div style="padding: 16px 24px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
    <div style="font-weight: 700; color: #334155; font-size: 0.92rem;">
      Showing <span style="color: #0077ff;"><%= blogs.length %></span> Articles
    </div>
    <div style="font-size: 0.8rem; color: #64748b;">
      Published live at /blog/:slug
    </div>
  </div>

  <% if (blogs.length === 0) { %>
    <div style="text-align: center; padding: 60px 20px;">
      <div style="font-size: 3rem; margin-bottom: 12px;">📝</div>
      <h3 style="font-size: 1.2rem; color: #06182f; font-weight: 800; margin-bottom: 6px;">No articles found</h3>
      <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 20px;">Get started by publishing your first clinical post.</p>
      <a href="/admin/blogs/new" class="btn-primary">Write Blog Post</a>
    </div>
  <% } else { %>
    <div style="overflow-x: auto;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Article Title &amp; URL</th>
            <th>Category</th>
            <th>Published Date</th>
            <th>Read Time</th>
            <th style="text-align: right; width: 150px;">Actions</th>
          </tr>
        </thead>
        <tbody id="blogsTableBody">
          <% blogs.forEach(post => { %>
            <tr data-title="<%= post.title.toLowerCase() %>" data-category="<%= (post.category || '').toLowerCase() %>">
              <td>
                <div style="font-weight: 800; color: #06182f; font-size: 0.95rem; line-height: 1.35; margin-bottom: 2px;">
                  <%= post.title %>
                </div>
                <div style="font-size: 0.76rem; color: #64748b; font-family: monospace;">
                  /blog/<%= post.slug %>
                </div>
              </td>
              <td>
                <span class="badge badge-primary"><%= post.category %></span>
              </td>
              <td style="font-size: 0.84rem; color: #475569;">
                <%= post.date %>
              </td>
              <td>
                <span class="badge" style="background: #f1f5f9; color: #475569;">
                  ⏱️ <%= post.readTime %>
                </span>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px; align-items: center;">
                  <a href="/blog/<%= post.slug %>" target="_blank" title="Preview on Live Site" style="padding: 6px 10px; background: #eef6ff; color: #0077ff; border-radius: 6px; text-decoration: none; font-size: 0.8rem; font-weight: 700;">
                    👁️
                  </a>
                  <a href="/admin/blogs/edit/<%= post.slug %>" title="Edit Article" style="padding: 6px 12px; background: #f1f5f9; color: #0f172a; border-radius: 6px; text-decoration: none; font-size: 0.8rem; font-weight: 700;">
                    ✏️ Edit
                  </a>
                  <form method="POST" action="/admin/blogs/delete/<%= post.slug %>" onsubmit="return confirm('Are you sure you want to permanently delete this article?');" style="display: inline;">
                    <button type="submit" title="Delete Article" class="btn-danger">
                      🗑️
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Instant client-side search enhancer -->
<script>
  const searchInput = document.getElementById('blogSearchInput');
  const tbody = document.getElementById('blogsTableBody');
  if (searchInput && tbody) {
    searchInput.addEventListener('keyup', function(e) {
      const q = e.target.value.toLowerCase().trim();
      const rows = tbody.getElementsByTagName('tr');
      for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        const title = row.getAttribute('data-title') || '';
        const cat = row.getAttribute('data-category') || '';
        if (!q || title.includes(q) || cat.includes(q)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      }
    });
  }
</script>

<%- include('./layout-footer') %>
