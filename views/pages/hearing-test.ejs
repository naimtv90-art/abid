<%- include('../layout/header', { 
  title: 'Free Online Hearing Test & Screening Quiz | Abid Hearing Care Dhaka', 
  currentPath: '/hearing-test', 
  metaDesc: 'Take our free 2-minute online hearing self-assessment quiz. Identify subtle hearing challenges, speech clarity difficulties, and tinnitus indicators.' 
}) %>

<!-- Hero Banner (Micro Style) -->
<div style="background: linear-gradient(135deg, #06182F 0%, #004b99 50%, #0077ff 100%); color: #ffffff; padding: 52px 0 56px; position: relative; overflow: hidden;">
  <div style="position: absolute; right: -80px; top: -80px; width: 340px; height: 340px; border-radius: 50%; background: radial-gradient(circle, rgba(0, 119, 255, 0.35) 0%, rgba(233, 16, 44, 0.12) 60%, transparent 80%); pointer-events: none;"></div>
  <div class="ct-container" style="position: relative; z-index: 1;">
    <span class="hero-badge">⚡ 2-MINUTE AUDITORY SCREENING</span>
    <h1 style="color: #ffffff; font-size: 2.35rem; font-weight: 800; margin: 10px 0 12px; line-height: 1.25; letter-spacing: -0.02em;">
      Free Online Hearing Self-Assessment Quiz
    </h1>
    <p style="color: #d0e4ff; max-width: 760px; font-size: 1.05rem; line-height: 1.6; margin-bottom: 0;">
      Answer 5 quick clinical questions to determine whether your daily listening fatigue, consonant confusion, or TV volume issues point toward early auditory deficits.
    </p>
  </div>
</div>

<!-- Main Content Area -->
<div class="ct-container" style="padding: 50px 20px 80px; max-width: 920px;">

  <!-- Interactive Quiz Card (Micro Card Styling) -->
  <div class="quiz-card" id="interactiveQuiz" style="border: 1.5px solid #dce8f8; border-radius: 24px; padding: 40px 32px; background: #ffffff; box-shadow: 0 14px 40px rgba(6, 24, 47, 0.08); margin-bottom: 40px;">
    
    <!-- Progress Bar -->
    <div style="background: #eef6ff; height: 10px; border-radius: 50px; overflow: hidden; margin-bottom: 30px; border: 1px solid #dce8f8;">
      <div id="quizProgressFill" style="background: linear-gradient(90deg, #0077ff, #00c6ff); height: 100%; width: 20%; transition: width 0.35s ease; border-radius: 50px;"></div>
    </div>

    <!-- Active Question View -->
    <div id="quizActiveView">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
        <span id="quizQNum" style="font-weight: 800; color: #0077ff; font-size: 0.92rem; text-transform: uppercase; letter-spacing: 0.05em; background: #eef6ff; padding: 4px 14px; border-radius: 50px; border: 1px solid #cbe2ff;">
          Question 1 of 5
        </span>
        <span style="font-size: 0.85rem; color: #64748b; font-weight: 600;">Standard Audiology Screening</span>
      </div>

      <h2 id="quizQText" style="color: #06182f; font-size: 1.45rem; line-height: 1.4; margin: 0 0 28px 0; min-height: 60px; font-weight: 800;">
        Do you frequently ask people to repeat themselves, especially in crowded environments or family gatherings?
      </h2>

      <div id="quizOptions" style="display: grid; grid-template-columns: 1fr; gap: 14px;">
        <!-- Dynamically injected by main.js with .quiz-opt-btn class -->
      </div>
    </div>

    <!-- Result View (Hidden initially) -->
    <div id="quizResultView" style="display: none; text-align: center; padding: 24px 0;">
      <div style="font-size: 3.8rem; margin-bottom: 14px;">📊</div>
      <span style="background: #eef6ff; color: #0077ff; font-weight: 800; font-size: 0.88rem; padding: 6px 18px; border-radius: 50px; display: inline-block; margin-bottom: 14px; border: 1px solid #cbe2ff;">
        Assessment Completed
      </span>
      
      <h2 style="color: #06182f; font-size: 1.85rem; font-weight: 800; margin: 8px 0;">
        Your Hearing Strain Index
      </h2>
      <div id="quizScoreText" style="font-size: 3.2rem; font-weight: 900; color: #0077ff; margin-bottom: 18px; letter-spacing: -0.02em;">
        0 / 10
      </div>
      
      <div style="background: #f8fbff; border: 1.5px solid #dce8f8; border-radius: 16px; padding: 24px 26px; max-width: 660px; margin: 0 auto 30px; text-align: left;">
        <p id="quizResultMessage" style="color: #334155; font-size: 1.05rem; line-height: 1.7; margin: 0; font-weight: 500;">
          <!-- Dynamically populated -->
        </p>
      </div>

      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <button type="button" class="btn" style="background: #0077ff; color: #ffffff; padding: 13px 26px; border-radius: 50px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 8px 20px rgba(0, 119, 255, 0.35);" data-open-modal data-product-name="Clinical PTA Test (Post-Quiz)">
          Book Full Diagnostic Hearing Test
        </button>
        <button type="button" class="btn" id="quizRetakeBtn" style="background: #f0f6ff; color: #0077ff; border: 1.5px solid #cbe2ff; padding: 13px 22px; border-radius: 50px; font-weight: 700; cursor: pointer;">
          Retake Quiz ↺
        </button>
      </div>
    </div>

  </div>

  <!-- Clinical PTA Soundproof Booth Notice (Micro Value Box) -->
  <div style="background: #ffffff; border: 1px solid #dce8f8; border-radius: 20px; padding: 32px 28px; margin-bottom: 40px; box-shadow: 0 8px 24px rgba(6, 24, 47, 0.04); display: flex; align-items: flex-start; gap: 20px;">
    <div style="width: 48px; height: 48px; border-radius: 12px; background: #eef6ff; color: #0077ff; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; flex-shrink: 0;">
      🎧
    </div>
    <div>
      <span class="section-badge" style="margin-bottom: 6px;">CLINICAL AUDIOLOGY NOTICE</span>
      <h3 style="color: #06182f; font-size: 1.3rem; font-weight: 800; margin: 4px 0 8px;">
        Online Screening vs. In-Booth Diagnostic Evaluation
      </h3>
      <p style="color: #52627a; font-size: 0.95rem; line-height: 1.65; margin: 0;">
        This online questionnaire is a subjective self-assessment screening designed to identify common auditory red flags. It does not substitute for a comprehensive pure-tone audiogram (PTA) or impedance tympanometry conducted inside an ISO-certified soundproof booth by a licensed clinical audiologist at our Uttara clinic.
      </p>
    </div>
  </div>

  <!-- Bottom CTA Banner -->
  <div style="background: linear-gradient(135deg, #06182F 0%, #082d5b 100%); border-radius: 24px; padding: 42px 32px; text-align: center; color: #ffffff; box-shadow: 0 18px 45px rgba(6, 24, 47, 0.18);">
    <span class="hero-badge" style="background: rgba(255,255,255,0.12); margin-bottom: 12px;">ISO-CALIBRATED SOUNDPROOF BOOTH</span>
    <h3 style="color: #ffffff; font-size: 1.85rem; font-weight: 800; margin: 10px 0 10px;">
      Schedule an In-Person Audiometry Test in Uttara
    </h3>
    <p style="color: #d0e4ff; max-width: 650px; margin: 0 auto 24px; font-size: 1rem; line-height: 1.6;">
      Get precise frequency-by-frequency hearing threshold measurements and personalized consultation with Clinical Audiologist Mohammad Haidar Ali.
    </p>
    <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
      <a href="/contact-us" class="btn" style="background: #0077ff; color: #ffffff; padding: 13px 26px; border-radius: 50px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 8px 20px rgba(0, 119, 255, 0.35);">
        Book Clinic Test
      </a>
      <a href="tel:01771237740" class="btn" style="background: #e9102c; color: #ffffff; padding: 13px 26px; border-radius: 50px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 8px 20px rgba(233, 16, 44, 0.35);">
        📞 Call 0177 123 77 40
      </a>
    </div>
  </div>

</div>

<%- include('../layout/footer') %>
