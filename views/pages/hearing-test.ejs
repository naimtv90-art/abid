<%- include('../layout/header', { title: 'Free Online Hearing Test & Screening Quiz | Abid Hearing Care Dhaka', currentPath: '/hearing-test', metaDesc: 'Take our free 2-minute online hearing self-assessment quiz. Identify subtle hearing challenges, speech clarity difficulties, and tinnitus indicators.' }) %>

<div style="background: var(--primary-900); color: #fff; padding: 50px 0;">
  <div class="container">
    <span class="section-tag" style="background: rgba(14, 165, 233, 0.2); color: #38bdf8;">Free Online Tool</span>
    <h1 style="color: #fff; font-size: 2.6rem; margin-top: 10px; margin-bottom: 12px;">Quick Hearing Self-Assessment Quiz</h1>
    <p style="color: #cbd5e1; max-width: 720px; font-size: 1.05rem;">
      Take this 2-minute clinical screening based on international audiology protocols. Discover if your listening effort points towards undiagnosed hearing loss.
    </p>
  </div>
</div>

<section class="section">
  <div class="container" style="max-width: 820px;">

    <!-- Interactive Quiz Card -->
    <div class="quiz-card" id="interactiveQuiz" style="border: 2px solid var(--primary-200); border-radius: 20px; padding: 36px; background: #fff; box-shadow: 0 10px 30px rgba(13, 82, 156, 0.08); margin-bottom: 40px;">
      
      <!-- Progress Bar -->
      <div style="background: var(--gray-100); height: 8px; border-radius: 99px; overflow: hidden; margin-bottom: 28px;">
        <div id="quizProgressFill" style="background: linear-gradient(90deg, var(--primary-600), var(--accent-500)); height: 100%; width: 20%; transition: width 0.3s ease;"></div>
      </div>

      <!-- Active View -->
      <div id="quizActiveView">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <span id="quizQNum" style="font-weight: 700; color: var(--primary-700); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em;">Question 1 of 5</span>
          <span style="font-size: 0.85rem; color: var(--gray-400);">Clinical Screening Protocol</span>
        </div>

        <h2 id="quizQText" style="color: var(--primary-900); font-size: 1.5rem; line-height: 1.4; margin: 0 0 28px 0; min-height: 60px;">
          Do you frequently ask people to repeat themselves, especially in crowded environments or family gatherings?
        </h2>

        <div id="quizOptions" style="display: grid; grid-template-columns: 1fr; gap: 14px;">
          <!-- Populated by main.js -->
        </div>
      </div>

      <!-- Result View (Hidden initially) -->
      <div id="quizResultView" style="display: none; text-align: center; padding: 20px 0;">
        <div style="font-size: 3.5rem; margin-bottom: 12px;">📊</div>
        <span class="badge" style="background: #e0f2fe; color: #0284c7; font-weight: 700; font-size: 0.9rem; padding: 6px 16px; margin-bottom: 16px; display: inline-block;">Assessment Complete</span>
        
        <h2 style="color: var(--primary-900); font-size: 1.8rem; margin: 8px 0;">Your Hearing Strain Score</h2>
        <div id="quizScoreText" style="font-size: 3rem; font-weight: 800; color: var(--primary-700); margin-bottom: 16px;">0 / 10</div>
        
        <div style="background: #f8fafc; border: 1px solid var(--gray-200); border-radius: 12px; padding: 24px; max-width: 650px; margin: 0 auto 30px auto; text-align: left;">
          <p id="quizResultMessage" style="color: var(--gray-700); font-size: 1.05rem; line-height: 1.7; margin: 0;">
            <!-- Message populated dynamically -->
          </p>
        </div>

        <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
          <button type="button" class="btn btn-primary btn-lg" data-open-modal data-product-name="Clinical PTA Test (Post-Quiz)">
            Book Full Diagnostic Hearing Test
          </button>
          <button type="button" class="btn btn-outline" id="quizRetakeBtn">
            Retake Quiz ↺
          </button>
        </div>
      </div>

    </div>

    <!-- Clinical PTA Notice -->
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 16px; padding: 28px; margin-bottom: 40px;">
      <h3 style="color: var(--primary-900); font-size: 1.25rem; margin-top: 0; margin-bottom: 8px;">Please Note: Online Screening vs. In-Booth Diagnostic</h3>
      <p style="color: #1e40af; font-size: 0.95rem; line-height: 1.65; margin-bottom: 0;">
        This online questionnaire is a subjective self-assessment tool designed to highlight common auditory red flags. It does not replace a comprehensive pure-tone audiogram (PTA) or impedance tympanometry conducted inside an ISO-certified soundproof booth by a licensed clinical audiologist.
      </p>
    </div>

  </div>
</section>

<%- include('../layout/footer') %>
