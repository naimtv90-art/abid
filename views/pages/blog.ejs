<%- include('../layout/header', { 
  title: 'Audiology Blog & Ear Care Insights | Abid Hearing Care Centre', 
  currentPath: '/blog', 
  metaDesc: 'Practical audiology reading, digital hearing aid maintenance guides, and everyday ear care advice from clinical audiologists at Abid Hearing Care Centre Dhaka.' 
}) %>

<!-- Hero Banner (Micro Style with Abid Trust Blue) -->
<section class="section" style="background: linear-gradient(135deg, #06182f 0%, #004b99 50%, #0077ff 100%); color: #ffffff; padding: 68px 0 72px; position: relative; overflow: hidden;">
  <div style="position: absolute; right: -80px; top: -80px; width: 340px; height: 340px; border-radius: 50%; background: radial-gradient(circle, rgba(0, 119, 255, 0.35) 0%, rgba(233, 16, 44, 0.15) 60%, transparent 80%); pointer-events: none;"></div>
  <div class="container" style="text-align: center; position: relative; z-index: 1;">
    <span class="hero-badge" style="background: rgba(255,255,255,0.18); color: #93c5fd; border: 1px solid rgba(255,255,255,0.25);">
      📚 Audiology &amp; Patient Insights
    </span>
    <h1 style="font-size: clamp(2rem, 3.8vw, 3.2rem); font-weight: 800; margin: 12px 0 16px; color: #ffffff; letter-spacing: -0.02em;">
      AHCC Ear Care &amp; Audiology Blog
    </h1>
    <p style="max-width: 760px; margin: 0 auto; color: #dbeafe; font-size: 1.12rem; line-height: 1.65;">
      Practical audiology reading, digital hearing aid maintenance guides, pediatric speech development, and everyday ear care advice from clinical audiologists at Abid Hearing Care Centre, Sector-7, Uttara, Dhaka.
    </p>
  </div>
</section>

<!-- Blog Articles Grid Section -->
<section class="section" style="padding-top: 40px; padding-bottom: 80px; background: #f8fafc;">
  <div class="container">

    <!-- Categories & Search Filter Bar -->
    <div style="background: #ffffff; border-radius: var(--radius-lg); padding: 18px 24px; border: 1.5px solid #e2e8f0; margin-bottom: 40px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; box-shadow: var(--shadow-sm);">
      
      <!-- Category Pills -->
      <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <span style="font-size: 0.85rem; font-weight: 700; color: #64748b; margin-right: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Filter By:</span>
        <% categories.forEach(cat => { %>
          <a href="/blog?category=<%= encodeURIComponent(cat) %><%= searchQuery ? ('&search=' + encodeURIComponent(searchQuery)) : '' %>" 
             style="padding: 7px 18px; border-radius: 9999px; font-size: 0.84rem; font-weight: 700; text-decoration: none; transition: all 0.2s ease; <%= selectedCategory === cat ? 'background: var(--color-primary); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 119, 255, 0.35);' : 'background: #f1f5f9; color: #475569;' %>">
            <%= cat %>
          </a>
        <% }); %>
      </div>

      <!-- Search Form -->
      <form action="/blog" method="GET" style="display: flex; gap: 8px; align-items: center;">
        <% if (selectedCategory && selectedCategory !== 'All') { %>
          <input type="hidden" name="category" value="<%= selectedCategory %>">
        <% } %>
        <div style="position: relative;">
          <input 
            type="text" 
            name="search" 
            placeholder="Search audiology guides..." 
            value="<%= searchQuery || '' %>" 
            style="padding: 9px 16px 9px 36px; border: 1.5px solid #cbd5e1; border-radius: 9999px; font-size: 0.88rem; outline: none; width: 230px; font-family: inherit; transition: border-color 0.2s;"
          >
          <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: #94a3b8;">🔍</span>
        </div>
        <button type="submit" class="btn btn-primary btn-sm" style="border-radius: 9999px; padding: 9px 18px; font-weight: 700;">
          Search
        </button>
        <% if (searchQuery || (selectedCategory && selectedCategory !== 'All')) { %>
          <a href="/blog" class="btn btn-secondary btn-sm" style="border-radius: 9999px; padding: 9px 14px; text-decoration: none; color: #ef4444; border: 1px solid #fecaca; background: #fef2f2;" title="Reset filters">
            ✕ Clear
          </a>
        <% } %>
      </form>
    </div>

    <!-- Articles Grid -->
    <% if (blogs && blogs.length > 0) { %>
      <div class="grid-3-col" style="gap: 28px;">
        <% blogs.forEach(post => { %>
          <article class="blog-card" style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; transition: transform 0.25s ease, box-shadow 0.25s ease;">
            
            <!-- Article Image with Category Overlay -->
            <a href="/blog/<%= post.slug %>" style="display: block; overflow: hidden; background: #eef6ff; height: 210px; position: relative;">
              <img 
                src="<%= post.image || '/images/abid-hearing-care-centre-clinic-dhaka-bangladesh.webp' %>" 
                alt="<%= post.title %> – Abid Hearing Care Centre" 
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" 
                onmouseover="this.style.transform='scale(1.05)'" 
                onmouseout="this.style.transform='scale(1)'"
                loading="lazy"
                onerror="this.src='/images/abid-hearing-care-centre-clinic-dhaka-bangladesh.webp'"
              >
              <span style="position: absolute; top: 14px; left: 14px; background: rgba(0, 119, 255, 0.95); color: #ffffff; font-size: 0.75rem; font-weight: 800; padding: 4px 12px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.04em; box-shadow: 0 2px 6px rgba(0,0,0,0.15);">
                <%= post.category %>
              </span>
            </a>

            <!-- Card Content Body -->
            <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
              
              <!-- Meta: Date & Read Time -->
              <div style="font-size: 0.8rem; color: #64748b; margin-bottom: 10px; display: flex; gap: 8px; align-items: center;">
                <span>📅 <%= post.date %></span>
                <span style="color: #cbd5e1;">&bull;</span>
                <span>⏱️ <%= post.readTime %></span>
              </div>

              <!-- Title -->
              <h2 style="font-size: 1.25rem; font-weight: 800; color: #06182f; margin-bottom: 12px; line-height: 1.35; letter-spacing: -0.01em;">
                <a href="/blog/<%= post.slug %>" style="color: inherit; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='#06182f'">
                  <%= post.title %>
                </a>
              </h2>

              <!-- Excerpt -->
              <p style="color: #52627a; font-size: 0.94rem; line-height: 1.6; margin-bottom: 22px; flex-grow: 1;">
                <%= post.excerpt %>
              </p>

              <!-- Footer Signature & Read Link -->
              <div style="padding-top: 16px; border-top: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.82rem; color: #64748b; font-weight: 600;">
                  By <%= post.author || 'Mohammad Haidar Ali' %>
                </span>
                <a href="/blog/<%= post.slug %>" style="font-size: 0.9rem; font-weight: 800; color: var(--color-primary); text-decoration: none; display: flex; align-items: center; gap: 4px;">
                  Read Article &rarr;
                </a>
              </div>

            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <!-- Empty Search State -->
      <div style="background: #ffffff; border-radius: 16px; padding: 60px 24px; text-align: center; border: 1.5px solid #e2e8f0;">
        <span style="font-size: 3rem; display: block; margin-bottom: 12px;">📑</span>
        <h3 style="font-size: 1.4rem; font-weight: 800; color: #06182f; margin-bottom: 8px;">No matching articles found</h3>
        <p style="color: #64748b; margin-bottom: 20px;">Try adjusting your search keywords or browsing all categories.</p>
        <a href="/blog" class="btn btn-primary" style="border-radius: 9999px;">View All Blog Articles</a>
      </div>
    <% } %>

    <!-- Patient Consultation Banner (Micro Style with Abid Brand Inclusions) -->
    <div style="margin-top: 60px; background: linear-gradient(135deg, #eef6ff 0%, #dbeafe 100%); border: 1.5px solid #bfdbfe; border-radius: var(--radius-xl); padding: 44px 36px; text-align: center; box-shadow: var(--shadow-sm);">
      <span class="section-badge" style="background: #ffffff; color: var(--color-primary);">CLINICAL CONSULTATION IN DHAKA</span>
      <h3 style="font-size: clamp(1.5rem, 2.8vw, 2rem); font-weight: 800; color: #06182f; margin: 12px 0 10px;">
        Have Questions About Your Hearing Health?
      </h3>
      <p style="max-width: 680px; margin: 0 auto 26px; color: #334155; font-size: 1.05rem; line-height: 1.6;">
        Book a professional diagnostic hearing evaluation with Abid Hearing Care Centre's certified audiology specialists in Sector-7, Uttara, Dhaka. Free digital device trials and computer fitting.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <button class="btn btn-primary btn-lg" data-open-appointment="true" style="border-radius: 9999px;">
          Book Hearing Test
        </button>
        <a href="https://wa.me/8801771237740?text=Hello%20Abid%20Hearing%20Care%20Centre,%20I%20read%20your%20audiology%20blog%20and%20want%20to%20consult%20an%20audiologist" target="_blank" class="btn btn-whatsapp btn-lg" style="border-radius: 9999px;">
          Chat on WhatsApp
        </a>
        <a href="tel:01771237740" class="btn btn-outline btn-lg" style="border-radius: 9999px; background: #ffffff;">
          📞 0177 123 77 40
        </a>
      </div>
    </div>

  </div>
</section>

<%- include('../layout/footer') %>
